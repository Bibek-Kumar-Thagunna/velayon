# Paddle.js uses a publishable client-side token. Never put a Paddle API key here.
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_replace_with_your_client_side_token
NEXT_PUBLIC_PADDLE_PRICE_ID=pri_replace_with_your_price_id

# Server-only secret copied from a Paddle notification destination.
# Never prefix this variable with NEXT_PUBLIC_ and never commit its real value.
PADDLE_WEBHOOK_SECRET=pdl_ntfset_replace_with_your_endpoint_secret
